# Supabase — required. Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — required for battle rewards (ELO/coins/badges)
# to be awarded. Project Settings → API → service_role (secret, NOT the anon
# key). Server-only — never exposed to the browser. Keep this out of any
# client-side code; it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# The app's own URL — used for auth redirects and share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI report card — optional. Set one; OpenAI is tried first, falls back to
# Anthropic if unset. If neither is set, the report-card feature errors out.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cron auth — optional. Any random string. Protects
# /api/cron/season-rollover from being called by anyone who finds the URL.
# Set the same value in Vercel's project env vars — Vercel Cron then sends
# it automatically as a Bearer token on scheduled invocations.
CRON_SECRET=
